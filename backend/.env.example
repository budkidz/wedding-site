# Copy this file to .env and fill in your own values.

# PostgreSQL connection string.
# Local example: postgresql://postgres:postgres@localhost:5432/wedding
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wedding

# Total seats — used to cap RSVPs and to show "x of 150 confirmed".
GUEST_CAPACITY=150

# Shared secret used to access the admin dashboard and approve invitations.
# Generate a long random value and keep it only in the backend environment.
ADMIN_API_KEY=

# Optional Telegram alert when a guest RSVPs "yes" and awaits approval.
# Leave blank to disable. Create a bot with @BotFather for the token.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated list of origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
